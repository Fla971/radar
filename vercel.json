{
  "version": 2,
  "builds": [
    { "src": "api/analyze.js", "use": "@vercel/node" },
    { "src": "api/unlock.js",  "use": "@vercel/node" },
    { "src": "index.html",     "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/analyze", "dest": "/api/analyze.js" },
    { "src": "/api/unlock",  "dest": "/api/unlock.js" },
    { "src": "/(.*)",        "dest": "/index.html" }
  ]
}
